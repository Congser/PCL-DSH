<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadMirror"
    PanScroll="PanBack">
    <!--
        PCL_DSH：镜像版本页。

        对接 npm 注册表，列出 @deepseek-ai/dsh 的全部可用版本，
        可以查看发布日期、一键安装或切换版本，也可以换镜像源。

        数据接口不需要认证、没有配额限制，所以这里不做缓存，点刷新就真刷。

        ⚠️ 整页必须包在 <local:MyScrollViewer x:Name="PanBack"> 里。
        根元素上的 PanScroll="PanBack" 只是**指向**这个名字的滚动容器 ——
        页里没有这个控件时它就是个空操作：页面既滚不动，
        FormMain 的「回到顶部」按钮也找不到目标（这一页早期版本就是这样）。
    -->
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,25,25,25">

                <!-- 版本状态 -->
                <local:MyCard Title="dsh 版本" Margin="0,0,0,15">
                    <StackPanel Margin="20,36,18,18">
                        <TextBlock x:Name="LabInstalledVersion" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Text="未安装" />
                        <TextBlock x:Name="LabVersionDetail" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap" LineHeight="21"
                                   Foreground="{DynamicResource ColorBrushGray2}"
                                   Text="点击「检查更新」从镜像源获取可用版本列表。" />

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <local:MyButton x:Name="BtnCheckUpdate" Text="检查更新" ColorType="Highlight" Margin="0,0,10,0" />
                            <local:MyButton x:Name="BtnInstallLatest" Text="安装最新版本" Margin="0,0,10,0"
                                            ToolTip="装「更新通道」里选定的那个版本。稳定通道装正式版，预览通道装含 alpha / beta / rc 的最新版。" />
                            <local:MyButton x:Name="BtnOpenDshFolder" Text="打开安装目录" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <!--
                    运行时槽位：可以有多个 dsh 运行时共存。
                      · 官方安装 —— pnpm 从镜像装的那一份，永远有一个
                      · 本地导入 —— 用户拖进来 / 选文件夹导入的完整包（可自带 Node）
                    切换后「启动用的入口脚本」「启动用的 Node」「版本号显示」
                    「体检报告」全部跟着变 —— 因为它们都从「激活槽位」推导。
                -->
                <local:MyCard Title="运行时（可切换）" Margin="0,0,0,15">
                    <StackPanel Margin="20,36,18,18">
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="多个 dsh 运行时可以共存并随时切换。切换后，启动用的入口、Node 和版本号都会跟着变。" />
                        <StackPanel x:Name="PanSlots" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <local:MyButton x:Name="BtnImportRuntime" Text="导入运行时…" ColorType="Highlight" Margin="0,0,10,0"
                                            ToolTip="选一个 zip 包或文件夹导入。PCL 会先校验它是不是完整的 dsh 运行时。" />
                            <local:MyButton x:Name="BtnRefreshSlots" Text="刷新列表" />
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <!-- 镜像源 -->
                <local:MyCard Title="镜像源与更新通道" Margin="0,0,0,15">
                    <StackPanel Margin="20,36,18,18">
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource ColorBrushGray4}"
                                   Text="三个源返回的版本列表完全一致，区别只在下载速度。国内推荐 npmmirror 或腾讯云镜像。换源后重新安装一次即可生效。" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="ComboMirror" Grid.Column="0" />
                            <TextBlock x:Name="LabMirrorNote" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                        </Grid>

                        <!-- 更新通道：决定「安装最新版本」按钮装哪一个。
                             用 SettingService 声明式绑定，勾选即自动写设置，无需手写事件。 -->
                        <TextBlock Margin="0,18,0,0" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource ColorBrush1}" Text="更新通道" />
                        <StackPanel Margin="0,10,0,0">
                            <local:MyRadioBox x:Name="RadioDshChannelStable" Text="稳定（推荐）"
                                              local:SettingService.Key="DshUpdateChannel" local:SettingService.Value="0"
                                              ToolTip="只装 dist-tags.latest 指向的版本，不含 alpha / beta / rc。" />
                            <local:MyRadioBox x:Name="RadioDshChannelPreview" Text="预览" Margin="0,8,0,0"
                                              local:SettingService.Key="DshUpdateChannel" local:SettingService.Value="1"
                                              ToolTip="装版本号最大的那个，包含 alpha / beta / rc 等预发布版本。" />
                        </StackPanel>
                        <TextBlock x:Name="LabChannelNote" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Text="决定上方「安装最新版本」按钮装哪一个。下方列表里仍可以手动安装任意版本。" />
                    </StackPanel>
                </local:MyCard>

                <!--
                    可用版本。

                    ⚠️ 这里刻意**不再自带 ScrollViewer** —— 整页共用一个（根部的 PanBack）。
                    嵌套两层滚动条会让滚轮行为变得难以预测：指针停在列表上时滚的是内层、
                    停在外面滚的是外层，而内层的高度又是算出来的，用户判断不出边界在哪。
                    列表长度在可接受范围内（npm 上的版本总数就那么多），整页滚动更直观。
                -->
                <local:MyCard Title="可用版本">
                    <Grid Margin="20,36,18,18">
                        <StackPanel x:Name="PanVersions" />
                        <TextBlock x:Name="LabVersionsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,10,0,10"
                                   FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource ColorBrushGray3}"
                                   Text="还没有版本列表。&#x0a;点击上方的「检查更新」从镜像源获取。" />
                    </Grid>
                </local:MyCard>

            </StackPanel>
        </local:MyScrollViewer>

        <!-- 加载中：刻意放在 ScrollViewer **外面**，这样它是在视口里居中，
             而不是跟着内容一起滚到页面深处 -->
        <local:MyCard x:Name="PanLoad" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                      SnapsToDevicePixels="True" UseAnimation="False">
            <StackPanel Margin="20,20,20,17">
                <local:MyLoading x:Name="LoadStart" Text="正在处理" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="LabLoadHint" Margin="0,12,0,0" FontSize="12.5" MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrushGray4}"
                           Text="正在从镜像源获取版本信息……" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
