<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageDownloadPlugin"
    PanScroll="PanBack">
    <!--
        PCL_DSH：插件社区页。

        数据源（可在「设置 → 启动 → 插件市场数据源」切换）：
          · 索引站 awesome-dsh-plugin.com（默认）—— 静态 JSON，4000+ 插件，无配额，含分类
          · GitHub topic:dsh-plugin（回退）—— 只一页 50 个，匿名配额 10 次/小时

        加载策略：**完全手动**（和「镜像版本」页一致）。
        进入页面什么都不发，由用户决定：
          · 「刷新插件列表」→ 强制联网重新获取
          · 「仅读缓存」    → 只读本地缓存，一个请求都不发
        缓存有效期随数据源变化（索引站 30 秒 / GitHub 30 分钟）。

        ⚠️ 2026-09-21 改动：**切回本页不再自动刷新**。
        原设计有一重「切回本页按缓存新鲜度自动重拉」，但索引站源 TTL 只有 30 秒，
        等于每次切页都真联网拉 4 MB，用户从别的页切过来就被卡一下，很烦。

        4062 条数据不能一次全渲染 —— 列表按 60 条一页做「加载更多」，
        否则首次进入会因为创建一个几千元素的视觉树而卡住好几秒。

        ⚠️ 整页必须包在 <local:MyScrollViewer x:Name="PanBack"> 里。
        根元素上的 PanScroll="PanBack" 只是**指向**这个名字的滚动容器 ——
        页里没有这个控件时它就是个空操作：页面既滚不动，
        FormMain 的「回到顶部」按钮也找不到目标（这一页早期版本就是这样）。
    -->
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,25,25,25">

                <!-- 目标实例 + 数据源 + 刷新 -->
                <local:MyCard Title="安装目标" Margin="0,0,0,15">
                    <StackPanel Margin="20,36,18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <local:MyComboBox x:Name="ComboInstance" Grid.Column="0" />
                            <TextBlock x:Name="LabInstanceNote" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <local:MyButton x:Name="BtnReload" Text="刷新插件列表" ColorType="Highlight" Margin="0,0,10,0"
                                                ToolTip="强制联网重新获取。索引站无配额；GitHub 源每小时只有 10 次额度。" />
                                <local:MyButton x:Name="BtnUseCache" Text="仅读缓存" Margin="0,0,10,0"
                                                ToolTip="不发任何请求，直接显示上次缓存的结果。" />
                                <local:MyButton x:Name="BtnImport" Text="手动导入" Margin="0,0,10,0"
                                                ToolTip="从 GitHub 链接、本地文件夹或剪贴板导入插件。" />
                                <local:MyButton x:Name="BtnOpenRepo" Text="在浏览器打开" />
                            </StackPanel>
                            <TextBlock x:Name="LabMarketStatus" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray4}" />
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <!-- 已安装 -->
                <local:MyCard Title="该实例已安装的插件" Margin="0,0,0,15">
                    <StackPanel Margin="20,36,18,16">
                        <StackPanel x:Name="PanInstalled" />
                        <local:MyButton x:Name="BtnRefreshInstalled" Text="刷新已安装列表" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    </StackPanel>
                </local:MyCard>

                <!--
                    插件市场。

                    ⚠️ 列表刻意**不再自带 ScrollViewer** —— 整页共用一个（根部的 PanBack）。
                    嵌套两层滚动条会让滚轮行为变得难以预测：指针停在列表上时滚的是内层、
                    停在外面滚的是外层，而内层高度又是算出来的，用户判断不出边界在哪。
                    列表本身按 60 条一页「加载更多」，长度由用户自己的点击决定，
                    所以整页滚动不会失控。
                -->
                <local:MyCard Title="插件市场">
                    <Grid Margin="20,36,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 搜索 / 分类 / 排序 / 导入入口 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextSearch" Grid.Column="0" Margin="0,0,10,0"
                                             HintText="搜索插件（空格分隔表示同时满足）" />
                            <local:MyComboBox x:Name="ComboCategory" Grid.Column="1" Margin="0,0,10,0" />
                            <local:MyComboBox x:Name="ComboSort" Grid.Column="2" />
                        </Grid>

                        <!-- 列表 -->
                        <Grid Grid.Row="1">
                            <StackPanel>
                                <StackPanel x:Name="PanPlugins" />
                                <!-- 加载更多：4062 条不能一次全渲染 -->
                                <StackPanel x:Name="PanMore" Margin="0,6,0,4" HorizontalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="LabPluginsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,10,0,10"
                                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"
                                       Foreground="{DynamicResource ColorBrushGray3}"
                                       Text="还没有插件列表。&#x0a;点击上方的「刷新插件列表」获取。" />
                        </Grid>
                    </Grid>
                </local:MyCard>

            </StackPanel>
        </local:MyScrollViewer>

        <!-- 加载中：刻意放在 ScrollViewer **外面**，这样它是在视口里居中，
             而不是跟着内容一起滚到页面深处 -->
        <local:MyCard x:Name="PanLoad" Visibility="Collapsed"
                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0"
                      SnapsToDevicePixels="True" UseAnimation="False">
            <StackPanel Margin="20,20,20,17">
                <local:MyLoading x:Name="LoadStart" Text="正在处理" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="LabLoadHint" Margin="0,12,0,0" FontSize="12.5" MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrushGray4}"
                           Text="正在获取插件列表……" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
