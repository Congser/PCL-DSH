<local:MyPageLeft x:Class="PageDSHLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCL"
             mc:Ignorable="d" x:Name="PanBack"
             d:DesignHeight="417.2" Width="300">
    <!--
        PCL_DSH：启动页左栏。

        多实例改造后的布局：
          状态徽标 → 我的实例（可点选）→ 端口 → 实例操作 → 模式 → 启动 → 版本/插件

        与旧版的差别：
          1. 新增「我的实例」列表，支持新建 / 重命名 / 删除（上限 4 个）
          2. 「离线 / 在线」改成「本地模型 / API Key」—— 本地模型分支尚未实现
          3. 端口从「设置页里的一个输入框」提到这里，直接编辑当前实例的端口
          4. 「版本设置」改成「插件管理」
          5. 运行时信息（Node / DSH 版本）挪进设置页，这里只留端口与状态，
             否则左栏在 300px 宽度下会挤成一团
    -->
    <!--
        PCL_DSH：常态视图。

        ⚠️ 这个 Grid **不要加 RenderTransform**。
        早期版本为了做「切到启动中视图」的缩放淡出效果给 PanInput 挂了
        ScaleTransform，结果和 PanLaunching 的动画互相干扰，
        留下「点了启动左边栏变小/变宽」的残影。
        现在视图切换是**纯可见性切换**（见 PageDSHLeft.xaml.vb 的视图切换区），
        不需要任何变换，也就没有残影可言。
    -->
    <Grid Name="PanInput">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
        </Grid.ColumnDefinitions>

        <!-- 状态徽标（当前实例的运行状态） -->
        <Grid Grid.ColumnSpan="5" Grid.Row="0" Margin="20,14,20,0">
            <Border x:Name="BorderStateBadge" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="13" MinHeight="27" MaxHeight="27">
                <StackPanel Orientation="Horizontal">
                    <Path x:Name="PathStateBadge" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="12,0,0,0"
                          Stretch="Uniform" Fill="{DynamicResource ColorBrush3}" MaxHeight="16" MaxWidth="16" VerticalAlignment="Center" Data="">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock x:Name="LabStateBadge" Text="未运行" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource ColorBrush3}" Margin="15,0,12,0" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ 我的实例 ══ -->
        <StackPanel Grid.ColumnSpan="5" Grid.Row="1" Margin="20,16,20,0">
            <Grid>
                <TextBlock Text="我的实例" FontSize="12" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock x:Name="LabInstanceCount" FontSize="12" Opacity="0.5" VerticalAlignment="Center" HorizontalAlignment="Right" Text="0 / 4" />
            </Grid>
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="176" Margin="0,6,0,0">
                <StackPanel x:Name="PanInstances" />
            </local:MyScrollViewer>
        </StackPanel>

        <!-- ══ 端口 ══ -->
        <Grid Grid.ColumnSpan="5" Grid.Row="2" Margin="20,14,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="监听端口" FontSize="12.5" VerticalAlignment="Center" />
            <local:MyTextBox x:Name="TextPort" Grid.Column="2" Height="30" HintText="0 = 自动选择" />
        </Grid>

        <!-- ══ 实例操作 ══ -->
        <Grid Grid.ColumnSpan="5" Grid.Row="3" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnNewInstance" Grid.Column="0" Height="30" Text="新建" TextPadding="6,0,6,0" />
            <local:MyButton x:Name="BtnRenameInstance" Grid.Column="2" Height="30" Text="重命名" TextPadding="6,0,6,0" />
            <local:MyButton x:Name="BtnDeleteInstance" Grid.Column="4" Height="30" Text="删除" TextPadding="6,0,6,0" />
        </Grid>

        <!-- ══ 模式：本地模型 / API Key ══ -->
        <Grid Grid.ColumnSpan="5" Grid.Row="4" Margin="20,12,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnModeLocal" Grid.Column="0" Height="32" Text="本地模型" TextPadding="6,0,6,0"
                            ToolTip="使用本地推理服务（Ollama / llama.cpp）。该分支尚未实现。" />
            <local:MyButton x:Name="BtnModeOnline" Grid.Column="2" Height="32" Text="API Key" TextPadding="6,0,6,0"
                            ToolTip="使用 DeepSeek 官方 API。在右侧面板填入密钥即可。" />
        </Grid>

        <!-- 启动按钮 -->
        <Grid Grid.ColumnSpan="5" Grid.Row="6" Margin="0,14,0,0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="AprilScaleTrans" />
                    <TranslateTransform x:Name="AprilPosTrans" />
                </TransformGroup>
            </Grid.RenderTransform>
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0" Text="启动 DSH" ColorType="Highlight" Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersion" Text="正在检测运行环境" Margin="35,0,35,10" IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11"
                       Foreground="{DynamicResource ColorBrushGray3}" RenderTransformOrigin="0.5,-0.2">
                <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="{Binding RealRenderTransform.ScaleX, ElementName=BtnLaunch, Mode=OneWay}"
                                    ScaleY="{Binding RealRenderTransform.ScaleY, ElementName=BtnLaunch, Mode=OneWay}" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>

        <!-- 版本选择 / 插件管理 -->
        <local:MyButton Grid.Row="7" Grid.Column="2" x:Name="BtnVersion" Height="35" Margin="0,10,10,0" Text="版本选择" />
        <local:MyButton Grid.Row="7" Grid.Column="3" x:Name="BtnPlugins" Height="35" Margin="0,10,10,0" TextPadding="36" Text="插件管理" />
    </Grid>

    <!-- ══════════════════════════════════════════════════════════
         启动中视图：沿用 PCL 原版 PageLaunchLeft 的 PanLaunching 骨架
         （加载环 + 标题 + 进度条 + 步骤信息 + 你知道吗 + 取消按钮）

         ⚠️ 同样**不加 RenderTransform / Opacity 动画**，
            只靠 Visibility 切换。理由见本文件顶部 PanInput 的注释。
         ══════════════════════════════════════════════════════════ -->
    <Grid Name="PanLaunching" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="1" RenderTransformOrigin="0.5,0.5" Margin="0,-7,0,0">
            <StackPanel.BitmapEffect>
                <DropShadowBitmapEffect Color="{StaticResource ColorObjectGray2}" ShadowDepth="1.5" Direction="270" Opacity="0.15" Softness="0.15" />
            </StackPanel.BitmapEffect>
            <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Height="50" Margin="0,10,0,5" />
            <TextBlock Name="LabLaunchingTitle" Margin="15,10,15,0" Text="正在启动 DSH" HorizontalAlignment="Center" FontSize="20" Foreground="{DynamicResource ColorBrush3}">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <TextBlock Name="LabLaunchingName" Margin="40,5,40,0" FontSize="13.5" Text="DeepSeek Harness" HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrush3}" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <SkewTransform AngleX="-3"/>
                </TextBlock.RenderTransform>
            </TextBlock>
            <!-- 进度条：两列比例由代码控制 -->
            <Grid Height="4" Margin="30,12,30,27" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Name="ProgressLaunchingFinished" Width="0*"/>
                    <ColumnDefinition Name="ProgressLaunchingUnfinished" Width="100*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Column="0" >
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                            <GradientStop Color="{DynamicResource ColorObject4}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrush6}" Opacity="0.6" />
            </Grid>
            <Grid HorizontalAlignment="Center" Name="PanLaunchingInfo">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="当前步骤" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="检测运行环境" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingStage" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="服务状态" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="未启动" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingState" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="启动进度" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" />
                <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="—" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingProgress" />

                <!-- 你知道吗 -->
                <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="5" Grid.RowSpan="2"
                      Width="260" Margin="0,16,0,2" Visibility="Collapsed" Opacity="0">
                    <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3" BorderBrush="{StaticResource ColorBrushGray1}" Opacity="0.5">
                        <Border.Clip>
                            <CombinedGeometry GeometryCombineMode="Exclude">
                                <CombinedGeometry.Geometry1>
                                    <RectangleGeometry Rect="0,0,1000,1000" />
                                </CombinedGeometry.Geometry1>
                                <CombinedGeometry.Geometry2>
                                    <RectangleGeometry Rect="94,0,72,10" />
                                </CombinedGeometry.Geometry2>
                            </CombinedGeometry>
                        </Border.Clip>
                    </Border>
                    <TextBlock FontSize="12.5" Text="你知道吗" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{StaticResource ColorBrushGray1}" Opacity="0.5" />
                    <TextBlock x:Name="LabLaunchingHint" FontSize="12.5" Text="" Margin="11,21,11,10" TextWrapping="Wrap" HorizontalAlignment="Center" />
                </Grid>
            </Grid>
        </StackPanel>
        <local:MyButton Grid.Row="4" x:Name="BtnCancel" Height="35" Margin="20,20,20,20" VerticalAlignment="Bottom" Text="取消" />
    </Grid>
</local:MyPageLeft>
